# Copy to backend/.env for local development. Never commit real values.

# PostgreSQL connection (postgres://, postgresql:// or postgresql+psycopg:// accepted)
DATABASE_URL=postgresql+psycopg://localhost/patient_registration

# "production" enables Secure cookies
ENVIRONMENT=development

# Admin key for the REST API (Bearer token) and the dashboard login. Use a long random value.
API_KEY=change-me
# Signs dashboard session cookies. Use a long random value.
SECRET_KEY=change-me
# Shared secret Vapi sends as X-Vapi-Secret on every webhook/tool call.
VAPI_WEBHOOK_SECRET=change-me

# Optional
CORS_ORIGINS=            # e.g. http://localhost:3000 for running the dashboard dev server
LOG_PII=false            # true logs unmasked patient fields (never in production)
CLINIC_TIMEZONE=America/New_York
SEED_DEMO_DATA=true      # insert 2 synthetic demo patients at startup (idempotent)

# Only for scripts/setup_vapi.py (not needed by the running server)
VAPI_API_KEY=
PUBLIC_BASE_URL=         # e.g. https://your-app.up.railway.app
